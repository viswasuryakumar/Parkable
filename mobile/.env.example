# Copy to .env (same directory). Expo loads it automatically on `npx expo start`.
# The live Parkable API endpoint (CloudFormation stack `parkable-api` output ApiEndpoint):
EXPO_PUBLIC_API_BASE_URL=https://8o6uod8i7f.execute-api.us-west-1.amazonaws.com/Prod

# VAPID public key for Web Push parking reminders (stack output VapidPublicKey,
# or `aws ssm get-parameter --name /parkable/vapid-public-key`). Public by
# design - the browser pins it when it subscribes - so it belongs in the client
# bundle. The matching PRIVATE key stays in SSM and never leaves the server.
# Leave unset to disable web push; the app falls back to the on-screen countdown.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
